{
	"name": "phpbbmodders/authorcolumn",
	"type": "phpbb-extension",
	"description": "Adds an Author column to forum topic lists and topic search results in prosilver and its child styles.",
	"homepage": "https://www.phpbbmodders.com/",
	"version": "1.0.0-dev",
	"keywords": [
		"phpbb",
		"extension",
		"author",
		"topic list",
		"prosilver"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "phpBB Modders",
			"email": "board@phpbbmodders.com",
			"homepage": "https://www.phpbbmodders.com/",
			"role": "Extension Developer"
		}
	],
	"require": {
		"php": ">=8.1.0",
		"composer/installers": "^1.0 || ^2.0"
	},
	"extra": {
		"display-name": "Author Column",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.19,<4.1.0@dev"
		}
	}
}
